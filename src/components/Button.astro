---
/**
 * Tombol dari design system: Primary (kuning) dan Outline (garis hitam).
 * Dengan href → <a>, tanpa href → <button>.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Props = {
  variant?: 'primary' | 'outline';
  size?: 'md' | 'lg' | 'xl';
  href?: string;
  external?: boolean;
  icon?: string;
  block?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class'>;

const {
  variant = 'primary',
  size = 'md',
  href,
  external = false,
  icon,
  block = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, block && 'btn--block', className].filter(Boolean).join(' ');
const isWhatsApp = icon === 'whatsapp-logo';
---

{
  href ? (
    <a
      href={href}
      class={classes}
      {...(external ? { target: '_blank', rel: 'noopener' } : {})}
      {...(rest as HTMLAttributes<'a'>)}
    >
      {icon && (
        <span class:list={['btn__icon', { 'btn__icon--wa': isWhatsApp && variant === 'outline' }]}>
          <Icon name={icon} size={variant === 'outline' ? 'var(--icon-lg)' : 'var(--icon-md)'} />
        </span>
      )}
      <span class="btn__label">
        <slot />
      </span>
    </a>
  ) : (
    <button class={classes} type="button" {...(rest as HTMLAttributes<'button'>)}>
      {icon && (
        <span class:list={['btn__icon', { 'btn__icon--wa': isWhatsApp && variant === 'outline' }]}>
          <Icon name={icon} size={variant === 'outline' ? 'var(--icon-lg)' : 'var(--icon-md)'} />
        </span>
      )}
      <span class="btn__label">
        <slot />
      </span>
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--size-touch);
    padding: 0 var(--space-5);
    border-radius: var(--radius-lg);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    line-height: var(--leading-body);
    text-decoration: none;
    text-align: center;
    color: var(--color-text);
    -webkit-tap-highlight-color: transparent;
  }

  .btn--primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding-inline: var(--space-btn-x);
  }

  .btn--outline {
    background: var(--color-surface);
    border: var(--border-width-strong) solid var(--color-ink);
  }

  .btn--lg {
    min-height: var(--size-button-lg);
  }

  .btn--xl {
    min-height: var(--size-button-xl);
    font-size: var(--text-body-lg-fixed);
  }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn__icon {
    display: inline-flex;
  }

  .btn__icon--wa {
    color: var(--color-whatsapp);
  }

  .btn[disabled],
  .btn[aria-disabled='true'] {
    opacity: 0.75;
    cursor: progress;
  }

  @media (hover: hover) {
    .btn--primary:hover {
      background: color-mix(in srgb, var(--color-primary), var(--color-ink) 6%);
    }

    .btn--outline:hover {
      background: var(--color-bg-subtle);
    }
  }
</style>
