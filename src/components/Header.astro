---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { greetingLink } from '../scripts/whatsapp';

interface Props {
  /** Bagian situs yang sedang dibuka, untuk aria-current. */
  current?: 'menu' | 'artikel';
}

const { current } = Astro.props;

// Link absolut agar berfungsi dari halaman mana pun; label panel mobile lebih panjang
const links = [
  { href: '/#menu', label: 'Menu', mobileLabel: 'Menu', key: 'menu' },
  { href: '/#lokasi', label: 'Lokasi', mobileLabel: 'Lokasi & Jam Buka' },
  { href: '/#saran', label: 'Saran', mobileLabel: 'Kritik & Saran' },
  { href: '/artikel', label: 'Artikel', mobileLabel: 'Artikel', key: 'artikel' },
];
---

<header class="header">
  <div class="header__inner container">
    <a href="/" class="logo" aria-label={`${site.name}, halaman utama`}>
      <span class="logo__mark">{site.name}</span>
    </a>
    <button
      type="button"
      class="header__toggle"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="header__toggle-icon" data-nav-icon="list"><Icon name="list" size="var(--icon-menu)" /></span>
      <span class="header__toggle-icon" data-nav-icon="x" hidden><Icon name="x" size="var(--icon-menu)" /></span>
    </button>
    <nav id="site-nav" class="nav" aria-label="Navigasi utama" data-nav>
      <ul class="nav__list">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav__link"
                aria-current={link.key && link.key === current ? 'page' : undefined}
              >
                <span class="nav__label nav__label--desktop">{link.label}</span>
                <span class="nav__label nav__label--mobile">{link.mobileLabel}</span>
                <span class="nav__caret">
                  <Icon name="caret-right" size="var(--icon-md)" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__cta">
        <Button href={greetingLink} external variant="outline" block icon="whatsapp-logo">Chat WhatsApp</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
      toggle.querySelector<HTMLElement>('[data-nav-icon="list"]')!.hidden = open;
      toggle.querySelector<HTMLElement>('[data-nav-icon="x"]')!.hidden = !open;
      nav.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (nav.classList.contains('is-open') && !nav.contains(target) && !toggle.contains(target)) setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    padding-right: var(--space-2);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    text-decoration: none;
  }

  .logo__mark {
    padding: var(--space-badge-y) var(--space-2);
    background: var(--color-primary);
    border-radius: var(--radius-sm) var(--radius-xs) var(--radius-sm) var(--radius-xs);
    font-family: var(--font-heading);
    font-size: var(--text-logo);
    font-weight: var(--weight-brand);
    letter-spacing: var(--tracking-logo);
    line-height: var(--leading-h3);
    color: var(--color-on-primary);
  }

  .header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-touch);
    height: var(--size-touch);
    color: var(--color-text);
  }

  .header__toggle-icon {
    display: inline-flex;
  }

  /* Mobile: panel di bawah header */
  .nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-1) var(--page-gutter) var(--space-6);
    background: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .nav.is-open {
    display: flex;
  }

  .nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--size-button-xl);
    border-bottom: var(--border-width) solid var(--color-border);
    font-size: var(--text-item);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .nav__label--desktop {
    display: none;
  }

  .nav__caret {
    display: inline-flex;
    color: var(--color-text-muted);
  }

  @media (min-width: 1024px) {
    .header__inner {
      padding-right: var(--page-gutter);
    }

    .header__toggle,
    .nav__cta,
    .nav__caret,
    .nav__label--mobile {
      display: none;
    }

    .nav__label--desktop {
      display: inline;
    }

    .nav,
    .nav.is-open {
      display: block;
      position: static;
      padding: 0;
      border: 0;
      background: none;
    }

    .nav__list {
      display: flex;
      gap: var(--space-2);
    }

    .nav__link {
      min-height: var(--size-touch);
      padding: 0 var(--space-4);
      border-bottom: var(--border-width-focus) solid transparent;
      border-top: var(--border-width-focus) solid transparent;
      font-size: var(--text-body);
    }

    .nav__link[aria-current='page'] {
      font-weight: var(--weight-bold);
      border-bottom-color: var(--color-ink);
    }
  }

  @media (hover: hover) {
    .nav__link:hover .nav__label {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
</style>
