---
import { bestSellers } from '../data/menu';
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';
import ScrollArrows from './ScrollArrows.astro';
---

<section class="best" aria-labelledby="best-title">
  <div class="best__head container">
    <h2 id="best-title" class="section-title">Paling Sering Dipesan</h2>
    <p class="best__hint" aria-hidden="true">Geser <Icon name="arrow-right" size="var(--icon-xs)" /></p>
    <ScrollArrows target="best-track" label="menu terlaris" />
  </div>
  <ul id="best-track" class="best__track scroller container">
    {bestSellers.map((item) => <ProductCard item={item} />)}
  </ul>
</section>

<style>
  .best {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-10) 0 var(--space-8);
    background: var(--color-bg-subtle);
  }

  .best__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .best__hint {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding-bottom: var(--space-1);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    line-height: 1.25;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .best__track {
    gap: var(--space-3);
  }

  @media (min-width: 1024px) {
    .best {
      gap: var(--space-6);
      padding: var(--space-18) 0 var(--space-8);
    }

    .best__hint {
      display: none;
    }

    .best__track {
      gap: var(--space-5);
    }
  }
</style>
