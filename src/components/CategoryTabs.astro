---
import type { Category } from '../data/menu';

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<nav class="tabs" aria-label="Kategori menu">
  <ul class="tabs__list" data-tabs>
    {
      categories.map((category, index) => (
        <li>
          <a
            href={`#${category.id}`}
            class="tab"
            data-tab={category.id}
            aria-current={index === 0 ? 'true' : undefined}
          >
            {category.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const list = document.querySelector<HTMLElement>('[data-tabs]');
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (list && tabs.length) {
    let lockUntil = 0;

    const setActive = (id: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === id;
        if (active) tab.setAttribute('aria-current', 'true');
        else tab.removeAttribute('aria-current');
        if (active) {
          // Gulir chip aktif agar terlihat, tanpa menggeser halaman
          const left = tab.offsetLeft - (list.clientWidth - tab.offsetWidth) / 2;
          list.scrollTo({ left, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        }
      });
    };

    list.addEventListener('click', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-tab]');
      if (!tab) return;
      const section = document.getElementById(tab.dataset.tab ?? '');
      if (!section) return;
      event.preventDefault();
      lockUntil = Date.now() + 800;
      setActive(section.id);
      section.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', `#${section.id}`);
    });

    // Chip aktif mengikuti posisi gulir
    const visible = new Map<string, boolean>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => visible.set(entry.target.id, entry.isIntersecting));
        if (Date.now() < lockUntil) return;
        const first = tabs.find((tab) => visible.get(tab.dataset.tab ?? ''));
        if (first?.dataset.tab) setActive(first.dataset.tab);
      },
      { rootMargin: '-140px 0px -55% 0px' },
    );
    tabs.forEach((tab) => {
      const section = document.getElementById(tab.dataset.tab ?? '');
      if (section) observer.observe(section);
    });
  }
</script>

<style>
  .tabs {
    position: sticky;
    top: var(--header-height);
    z-index: 20;
    background: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .tabs__list {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-2-5) var(--page-gutter);
    overflow-x: auto;
    scrollbar-width: none;
    scroll-padding-inline: var(--page-gutter);
  }

  .tabs__list::-webkit-scrollbar {
    display: none;
  }

  .tabs__list li {
    flex: none;
  }

  .tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--size-chip);
    padding: 0 var(--space-4-5);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    color: var(--color-text);
  }

  /* Chip setinggi 44px (desain); area sentuh diperluas menjadi 48px */
  .tab::after {
    content: '';
    position: absolute;
    inset: -2px 0;
  }

  .tab[aria-current='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  @media (hover: hover) {
    .tab:not([aria-current='true']):hover {
      border-color: var(--color-ink);
    }
  }

  @media (min-width: 1024px) {
    .tabs {
      border-bottom: 0;
    }

    .tabs__list {
      padding: var(--space-3) var(--page-gutter);
    }
  }
</style>
