---
import { Picture } from 'astro:assets';
import type { MenuItem } from '../data/menu';
import { formatRupiah } from '../lib/format';
import QtyControl from './QtyControl.astro';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
---

<li class="card">
  <div class="card__photo">
    {
      item.image && (
        <Picture
          src={item.image.src}
          formats={['avif', 'webp']}
          widths={[240, 480]}
          sizes="(min-width: 1024px) 240px, 208px"
          alt={item.image.alt}
          loading="lazy"
          decoding="async"
          class="card__img"
        />
      )
    }
    {item.badge && <span class="card__badge">{item.badge}</span>}
  </div>
  <div class="card__body">
    <div class="card__text">
      <h3 class="card__name">{item.orderName}</h3>
      <p class="card__price">{formatRupiah(item.price)}</p>
    </div>
    <QtyControl slug={item.slug} name={item.orderName} variant="card" />
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    width: var(--product-card-width);
    overflow: hidden;
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .card__photo {
    position: relative;
    height: var(--product-photo-height);
    background: var(--color-bg-subtle);
  }

  .card__photo :global(picture) {
    display: block;
    height: 100%;
  }

  .card__photo :global(.card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__badge {
    position: absolute;
    top: var(--space-2-5);
    left: var(--space-2-5);
    padding: var(--space-badge-y) var(--space-2);
    background: var(--color-primary);
    border-radius: var(--radius-sm);
    font-size: var(--text-badge);
    font-weight: var(--weight-bold);
    line-height: var(--leading-item);
    color: var(--color-on-primary);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
    padding: var(--space-3);
  }

  .card__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-0-5);
    height: var(--product-text-height);
  }

  .card__name {
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    line-height: var(--leading-card-name);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__price {
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 1024px) {
    .card {
      flex: 1 0 var(--product-card-width);
      width: auto;
    }

    .card__photo {
      height: var(--product-photo-height-lg);
    }
  }
</style>
